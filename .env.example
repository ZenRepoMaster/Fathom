# Chat model via HuggingFace Router (OpenAI-compatible completions API)
LLM_BASE_URL=https://router.huggingface.co/v1
LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
LLM_API_KEY=your_hf_api_key_here

# Vector embeddings via HuggingFace Inference (OpenAI-compatible)
# If requests 404, try EMBEDDING_BASE_URL with a trailing /v1
EMBEDDING_BASE_URL=https://router.huggingface.co/hf-inference
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_API_KEY=your_hf_api_key_here
EMBEDDING_DIMENSIONS=384

# Pinecone index that holds memo / report chunks
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=financial-docs
PINECONE_ENVIRONMENT=us-east-1

# Postgres DSN for the tabular financial metrics
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/financial_db

# Set true if you want SQL and retrieval steps logged
VERBOSE=false

DB_POOL_SIZE=5
DB_POOL_TIMEOUT=30

CHUNK_SIZE=500
CHUNK_OVERLAP=50

INGEST_BATCH_SIZE=100

SQL_TIMEOUT=30
MAX_TOKENS=2048

MAX_CONTEXT_CHUNKS=3

CORS_ORIGINS=*
REQUEST_TIMEOUT=60

ENABLE_PARALLEL_SEARCH=true
PARALLEL_TIMEOUT=45
SEARCH_CONCURRENCY=5

CACHE_ENABLED=true
CACHE_TTL=300
CACHE_MAX_SIZE=100

LOG_LEVEL=INFO
LOG_FORMAT=json

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

DEFAULT_TICKER=AURM
SUPPORTED_TICKERS=AURM

QUERY_MAX_LENGTH=500

PINECONE_REQUEST_TIMEOUT=10

DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600
