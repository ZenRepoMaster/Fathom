# Chat model via HuggingFace Router (OpenAI-compatible completions API)
LLM_BASE_URL=https://router.huggingface.co/v1
LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
LLM_API_KEY=your_hf_api_key_here

# Vector embeddings via HuggingFace Inference (OpenAI-compatible)
# If requests 404, try EMBEDDING_BASE_URL with a trailing /v1
EMBEDDING_BASE_URL=https://router.huggingface.co/hf-inference
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_API_KEY=your_hf_api_key_here
EMBEDDING_DIMENSIONS=384

# Pinecone index that holds memo / report chunks
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=financial-docs
PINECONE_ENVIRONMENT=us-east-1

# Postgres DSN for the tabular financial metrics
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/financial_db

# Set true if you want SQL and retrieval steps logged
VERBOSE=false
